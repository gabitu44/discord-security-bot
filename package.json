{
  "name": "security-bot",
  "version": "1.0.0",
  "description": "Discord anti-nuke, moderation, and logging bot",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/security-bot.exe"
  },
  "keywords": [
    "discord",
    "bot",
    "moderation",
    "anti-nuke",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "index.js"
    ],
    "assets": [],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
